# Secret — setează-l în Rapids ca variabilă secretă, NU îl comite.
MISTRAL_API_KEY=

# Token partajat cu aplicația (ajunge în bundle — obfuscare, nu securitate).
# Generează: openssl rand -hex 24
PROXY_APP_TOKEN=

# Plafoane (toate au default-uri în config.js; setează doar ce vrei să schimbi)
# PER_DEVICE_DAILY_LIMIT=10
# GLOBAL_DAILY_LIMIT=5000
# MAX_TOKENS_CAP=4000
# ALLOWED_MODELS=mistral-small-latest,mistral-large-latest,pixtral-large-latest
