# Providerul din spate. Secret — setează-l în Rapids, NU îl comite.
# (Numele MISTRAL_API_KEY / MISTRAL_URL sunt acceptate ca alias.)
AI_UPSTREAM_API_KEY=
# Mistral:  https://api.mistral.ai/v1
# Gemini:   https://generativelanguage.googleapis.com/v1beta/openai
AI_UPSTREAM_URL=

# Traducere nume model: ce trimite aplicația -> ce cere providerul.
# Gol = fără traducere. Exemplu pentru Gemini:
# MODEL_MAP={"mistral-small-latest":"gemini-3.8-flash","mistral-large-latest":"gemini-3.8-flash","pixtral-large-latest":"gemini-3.8-flash"}
MODEL_MAP=

# Token partajat cu aplicația (ajunge în bundle — obfuscare, nu securitate).
# Generează: openssl rand -hex 24
PROXY_APP_TOKEN=

# Plafoane (toate au default-uri în config.js; setează doar ce vrei să schimbi)
# PER_DEVICE_DAILY_LIMIT=10
# GLOBAL_DAILY_LIMIT=5000
# MAX_TOKENS_CAP=4000
# ALLOWED_MODELS=mistral-small-latest,mistral-large-latest,pixtral-large-latest
